# Files that should NOT be included in the pub.dev package tarball.
#
# Pub uses this file *instead of* .gitignore when present, so every
# pattern that matters must be listed here explicitly. See
# https://dart.dev/tools/pub/publishing#pubignore

# --- Build output and caches ---
.dart_tool/
build/
doc/api/

# --- Editor and OS metadata ---
.idea/
.vscode/
.DS_Store
.env*

# --- Internal tooling instructions for agentic coding assistants ---
CLAUDE.md
AGENTS.md
.codex/

# --- Developer-only verification tools (not part of the library) ---
tool/

# --- CLI sub-package (dart_accuraterip_cli, shipped separately) ---
# NOTE: this pattern leaks into `dart pub publish` runs made from
# inside cli/ (parent ignore files apply to sub-directories, and
# pub does NOT auto-exclude nested packages — verified on Dart
# 3.12), where it manifests as "The pubspec is hidden". Publish the
# cli with tool/publish_cli.sh, which exports cli/ to a clean
# directory outside the repo first.
cli/

# --- Benchmarks (developer-only, not part of the library) ---
benchmark/
